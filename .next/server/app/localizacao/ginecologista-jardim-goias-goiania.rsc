1a:T4ae,{"@context":"https://schema.org","@type":"Physician","name":"Dr. Jony Barbosa - Ginecologista no Jardim Goiás em Goiânia","url":"https://drjonybarbosa.com.br/localizacao/ginecologista-jardim-goias-goiania","telephone":"(62) 3070-5555","address":{"@type":"PostalAddress","streetAddress":"Edificio Absolut Business Style - Av. T-4, 1478 - 2 Andar - St. Bueno","addressLocality":"Goiânia","addressRegion":"GO","postalCode":"74230-030","addressCountry":"BR"},"geo":{"@type":"GeoCoordinates","latitude":-16.7028135,"longitude":-49.2676839},"areaServed":[{"@type":"City","name":"Goiânia"},{"@type":"Neighborhood","name":"Jardim Goiás"}],"medicalSpecialty":["Gynecology","Obstetrics"],"availableService":[{"@type":"MedicalTherapy","name":"Ginecologia","url":"https://drjonybarbosa.com.br/especialidades/ginecologia-goiania"},{"@type":"MedicalTherapy","name":"Obstetrícia","url":"https://drjonybarbosa.com.br/especialidades/obstetricia-goiania"},{"@type":"MedicalTherapy","name":"Ultrassonografia","url":"https://drjonybarbosa.com.br/especialidades/ultrassonografia-goiania"},{"@type":"MedicalTherapy","name":"Consulta Médica","url":"https://drjonybarbosa.com.br/servicos/consulta-medica-goiania"}]}1b:T606,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Onde o Dr. Jony atende pacientes do Jardim Goiás?","acceptedAnswer":{"@type":"Answer","text":"As pacientes do Jardim Goiás são atendidas em FetalCenter Goiânia, no endereço Edificio Absolut Business Style - Av. T-4, 1478 - 2 Andar - St. Bueno, Goiânia - GO, 74230-030. A equipe envia a melhor orientação de chegada no momento do agendamento."}},{"@type":"Question","name":"Quais atendimentos costumam ser mais procurados por quem mora no Jardim Goiás?","acceptedAnswer":{"@type":"Answer","text":"Entre os atendimentos mais buscados por pacientes do Jardim Goiás estão Ginecologia, Obstetrícia, Ultrassonografia. A indicação ideal depende da sua fase de vida, sintomas, exames prévios e objetivos do tratamento."}},{"@type":"Question","name":"Como funciona o agendamento para pacientes do Jardim Goiás?","acceptedAnswer":{"@type":"Answer","text":"O agendamento é feito pelo WhatsApp. A equipe orienta horários, documentos, preparo quando houver exame, a unidade mais conveniente e como funciona o fluxo para atendimento particular ou pacientes Unimed."}},{"@type":"Question","name":"Quem mora no Jardim Goiás pode fazer acompanhamento completo com o Dr. Jony?","acceptedAnswer":{"@type":"Answer","text":"Sim. O atendimento cobre consulta ginecológica, pré-natal, medicina fetal, ultrassonografia e procedimentos conforme indicação clínica. Quando necessário, o cuidado continua com retornos e planejamento do tratamento."}}]}17:["$","main",null,{"className":"page-main flex-grow","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Início\",\"item\":\"https://drjonybarbosa.com.br\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Localização\",\"item\":\"https://drjonybarbosa.com.br/localizacao\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Jardim Goiás\",\"item\":\"https://drjonybarbosa.com.br/localizacao/ginecologista-jardim-goias-goiania\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1a"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}]
