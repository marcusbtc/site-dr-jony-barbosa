d:T4ac,{"@context":"https://schema.org","@type":"Physician","name":"Dr. Jony Barbosa - Ginecologista no Setor Bueno em Goiânia","url":"https://drjonybarbosa.com.br/localizacao/ginecologista-setor-bueno-goiania","telephone":"(62) 3070-5555","address":{"@type":"PostalAddress","streetAddress":"Edificio Absolut Business Style - Av. T-4, 1478 - 2 Andar - St. Bueno","addressLocality":"Goiânia","addressRegion":"GO","postalCode":"74230-030","addressCountry":"BR"},"geo":{"@type":"GeoCoordinates","latitude":-16.7028135,"longitude":-49.2676839},"areaServed":[{"@type":"City","name":"Goiânia"},{"@type":"Neighborhood","name":"Setor Bueno"}],"medicalSpecialty":["Gynecology","Obstetrics"],"availableService":[{"@type":"MedicalTherapy","name":"Ginecologia","url":"https://drjonybarbosa.com.br/especialidades/ginecologia-goiania"},{"@type":"MedicalTherapy","name":"Obstetrícia","url":"https://drjonybarbosa.com.br/especialidades/obstetricia-goiania"},{"@type":"MedicalTherapy","name":"Medicina Fetal","url":"https://drjonybarbosa.com.br/especialidades/medicina-fetal-goiania"},{"@type":"MedicalTherapy","name":"Ultrassonografia","url":"https://drjonybarbosa.com.br/especialidades/ultrassonografia-goiania"}]}e:T5f8,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Onde o Dr. Jony atende pacientes do Setor Bueno?","acceptedAnswer":{"@type":"Answer","text":"As pacientes do Setor Bueno são atendidas em FetalCenter Goiânia, no endereço Edificio Absolut Business Style - Av. T-4, 1478 - 2 Andar - St. Bueno, Goiânia - GO, 74230-030. A equipe envia a melhor orientação de chegada no momento do agendamento."}},{"@type":"Question","name":"Quais atendimentos costumam ser mais procurados por quem mora no Setor Bueno?","acceptedAnswer":{"@type":"Answer","text":"Entre os atendimentos mais buscados por pacientes do Setor Bueno estão Ginecologia, Obstetrícia, Medicina Fetal. A indicação ideal depende da sua fase de vida, sintomas, exames prévios e objetivos do tratamento."}},{"@type":"Question","name":"Como funciona o agendamento para pacientes do Setor Bueno?","acceptedAnswer":{"@type":"Answer","text":"O agendamento é feito pelo WhatsApp. A equipe orienta horários, documentos, preparo quando houver exame, a unidade mais conveniente e como funciona o fluxo para atendimento particular ou pacientes Unimed."}},{"@type":"Question","name":"Quem mora no Setor Bueno pode fazer acompanhamento completo com o Dr. Jony?","acceptedAnswer":{"@type":"Answer","text":"Sim. O atendimento cobre consulta ginecológica, pré-natal, medicina fetal, ultrassonografia e procedimentos conforme indicação clínica. Quando necessário, o cuidado continua com retornos e planejamento do tratamento."}}]}8:["$","main",null,{"className":"page-main flex-grow","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Início\",\"item\":\"https://drjonybarbosa.com.br\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Localização\",\"item\":\"https://drjonybarbosa.com.br/localizacao\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Setor Bueno\",\"item\":\"https://drjonybarbosa.com.br/localizacao/ginecologista-setor-bueno-goiania\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$e"}}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}]
